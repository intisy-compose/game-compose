# Copy to config.env and fill in. config.env is gitignored (holds secrets).

# Tunnel provider that exposes the servers publicly: playit | frp
TUNNEL=playit

# --- playit.gg (used when TUNNEL=playit) ---
# Secret from your playit.gg account/agent.
PLAYIT_SECRET=

# --- frp (used when TUNNEL=frp) ---
# Self-hosted frps on a VPS with a public IP; frpc connects out to it.
# Put the frps near your players for low latency.
FRP_SERVER_ADDR=
FRP_SERVER_PORT=7000
FRP_TOKEN=
